            <!-- Extract Order ID from the confirmation page -->
            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Extract Order ID" enabled="true">
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">orderId</stringProp>
              <stringProp name="RegexExtractor.regex">Order #(\d+)</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">NO_ORDER_ID</stringProp>
              <stringProp name="RegexExtractor.match_number">1</stringProp>
            </RegexExtractor>
            <hashTree/>
            <!-- Write Order ID to file -->
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Write Order ID to File" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"/>
              <stringProp name="parameters"/>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">
def orderId = vars.get("orderId")
if (orderId != null &amp;&amp; orderId != "NO_ORDER_ID") {
    def timestamp = new Date().format("yyyy-MM-dd HH:mm:ss")
    def threadName = ctx.getThread().getThreadName()
    def line = "${orderId},${threadName},${timestamp}\n"
    
    // Thread-safe file write
    def file = new File("order_ids.csv")
    synchronized(file) {
        if (!file.exists()) {
            file.text = "OrderID,ThreadName,Timestamp\n"
        }
        file.append(line)
    }
    log.info("Order placed successfully: ID=" + orderId)
}
              </stringProp>
