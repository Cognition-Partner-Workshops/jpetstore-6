        <!-- ========== JSR223: Pick a random category ========== -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Pick Random Category" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"/>
          <stringProp name="parameters"/>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
// Get the count of extracted categories
def count = vars.get("categoryId_matchNr")
if (count == null || count == "0") {
    log.error("No categories found after login!")
    vars.put("selectedCategory", "FISH") // fallback
    SampleResult.setSuccessful(true)
    return
}
int matchCount = count.toInteger()
// Pick a random category
int randomIndex = new Random().nextInt(matchCount) + 1
def selectedCategory = vars.get("categoryId_" + randomIndex)
vars.put("selectedCategory", selectedCategory)
log.info("Selected random category: " + selectedCategory)
SampleResult.setSuccessful(true)
SampleResult.setResponseData("Selected category: " + selectedCategory, "UTF-8")
SampleResult.setResponseCode("200")
SampleResult.setResponseMessage("OK")
          </stringProp>
        </JSR223Sampler>
        <hashTree/>

