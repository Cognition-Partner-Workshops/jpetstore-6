            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Extract_CategoryIds" enabled="true">
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">catId</stringProp>
              <stringProp name="RegexExtractor.regex">viewCategory=&amp;amp;categoryId=([A-Z]+)</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
              <stringProp name="RegexExtractor.match_number">-1</stringProp>
            </RegexExtractor>
            <hashTree/>

            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Shuffle_Categories" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">int count = vars.get("catId_matchNr")?.toInteger() ?: 0
def categories = [] as LinkedHashSet
for (int i = 1; i &lt;= count; i++) {
    String val = vars.get("catId_" + i)
    if (val &amp;&amp; val != "NOT_FOUND") {
        categories.add(val)
    }
}
def catList = categories.toList()
Collections.shuffle(catList)
for (int i = 1; i &lt;= 20; i++) { vars.remove("category_" + i) }
for (int i = 0; i &lt; catList.size(); i++) {
    vars.put("category_" + (i + 1), catList[i])
}
vars.put("category_matchNr", String.valueOf(catList.size()))
log.info("JPetStore: Extracted " + catList.size() + " categories: " + catList)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>

